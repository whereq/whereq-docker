# =============================================================================
# whereq-hermes — copy to .env (gitignored) and edit.
# Compose reads this file automatically for ${VAR} substitution.
# =============================================================================

# Which backend to talk to: anthropic | openai | gemini | deepseek | ollama.
LLM_PROVIDER=anthropic

# The key for that backend. Keep it here (gitignored) rather than in the
# image, and prefer a mount of /config/env for anything shared.
WQ_API_KEY=

# Optional: force a specific model instead of Hermes' own default.
WQ_MODEL=

# Host directory mounted at /workspace. Defaults to ./workspace.
WORKSPACE=./workspace

# Timezone for the container.
TZ=UTC

# The uid/gid the container runs as, and the owner of the mounted volumes.
# Set these to your own (`id -u` / `id -g`) if they are not 1000 — they are
# build args, so changing them makes compose rebuild the image.
HERMES_UID=1000
HERMES_GID=1000
