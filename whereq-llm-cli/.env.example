# =============================================================================
# whereq-llm-cli — copy to .env (gitignored) and edit.
# Compose reads this file automatically for ${VAR} substitution.
# =============================================================================

# Which backend profile to load: anthropic | openai | gemini | deepseek |
# minimax | openrouter | ollama | custom.  See providers/*.env.
LLM_PROVIDER=anthropic

# The key for that backend. Keep it here (gitignored) rather than in the
# image, and prefer a mount of /config/env for anything shared.
WQ_API_KEY=

# Optional: force a specific model instead of each CLI's own default.
WQ_MODEL=

# Host directory mounted at /workspace. Defaults to ./workspace.
WORKSPACE=./workspace

# Timezone for the container (Python, git, CLIs all read this).
TZ=UTC
