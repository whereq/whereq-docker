# DeepSeek. Two protocols, two endpoints:
#   WQ_BASE_URL          → OpenAI-compatible (/chat/completions) for codex.
#   WQ_ANTHROPIC_BASE_URL → Anthropic-compatible (/anthropic/messages), which
#                          is what Claude Code needs to talk to DeepSeek.
WQ_BASE_URL=https://api.deepseek.com
WQ_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
