# =============================================================================
# whereq-db — runtime configuration for bin/whereq-db
# =============================================================================
# Copy to `whereq-db/.env` (gitignored) and adjust per host. The same script
# serves LOCAL and PROD — only these values differ between them.
#
#   cp whereq-db/.env.example whereq-db/.env
#
# TWO consumers read this file, and they do not use the same variable names:
#
#   bin/whereq-db                      → WHEREQ_DB_*  and POSTGRES_*
#   whereq-db/docker-compose-prod.yml  → POSTGRES_* , DB_PORT , POSTGRES_DATA_PATH
#
# The pairs below (WHEREQ_DB_PORT / DB_PORT, WHEREQ_DB_DATA /
# POSTGRES_DATA_PATH) describe the SAME host port and the SAME bind mount —
# they are kept in step because two different tools read them.
#
# `up` on an already-created container just does `docker start` and needs none
# of these; POSTGRES_PASSWORD is only consumed when the container is created
# for the FIRST time (fresh data dir).
# =============================================================================

# ── Image + container identity (rarely changed) ──
WHEREQ_DB_IMAGE=whereq-postgres:17
WHEREQ_DB_CONTAINER=whereq-db
WHEREQ_NETWORK=whereq-network

# ── Published port on the host ──
WHEREQ_DB_PORT=5432
DB_PORT=5432

# ── Host bind mount for the cluster data directory ──
# Data survives container rebuilds/recreates. LOCAL default below; PROD sets
# its own path.
WHEREQ_DB_DATA=/home/whereq/docker/postgres/data
POSTGRES_DATA_PATH=/home/whereq/docker/postgres/data

# ── Cluster SUPERUSER + bootstrap database ──
# Bootstraps the empty cluster on first init only. The shared cluster's
# superuser is "whereq" and its bootstrap database is "whereq-com"; the
# application databases (k2m, flowdesk, catobigato) live alongside it.
# do NOT commit real secrets — keep them in .env, not here.
POSTGRES_USER=whereq
POSTGRES_DB=whereq-com
POSTGRES_PASSWORD=WhereQ123

# Not read by any script today — kept for parity with the published template.
POSTGRES_PASSWORD_ENCODED=WhereQ123
