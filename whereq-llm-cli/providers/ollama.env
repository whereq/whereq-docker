# Local Ollama (whereq-ollama / whereq-ollama-mistral7b, or ollama on the host).
# On Linux, `host.docker.internal` needs:  extra_hosts: ["host.docker.internal:host-gateway"]
# To use the sibling container instead, attach to its network and use its name:
#   WQ_BASE_URL=http://ollama:11434/v1
WQ_BASE_URL=http://host.docker.internal:11434/v1
WQ_API_KEY=ollama          # OpenAI clients insist on a key; Ollama ignores it
# WQ_MODEL=mistral:7b
